# Copiá este archivo como ".env" y completá los valores. El .env NUNCA se sube a GitHub.
# En Vercel, estas mismas variables se cargan en: Project → Settings → Environment Variables.

# MongoDB Atlas → tu cluster → Connect → Drivers (reemplazá <password> por la del usuario de la base)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=icobatista

# Cloudinary → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Clave para firmar las sesiones del panel (mínimo 32 caracteres, al azar). Generala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---- Entradas del desfile (server/entradas) ----
# Sin MP_MODE, en Vercel la venta queda CERRADA ("La venta abre muy pronto"). En tu PC usa el simulador.
#   live = Mercado Pago real (requiere todo lo de abajo)
MP_MODE=
# Access Token de PRODUCCIÓN de la cuenta de Ico (Mercado Pago > Tus integraciones > Credenciales de producción)
MP_ACCESS_TOKEN=
# Clave secreta del webhook (Tus integraciones > Webhooks). URL del webhook: https://icobatista.com/api/entradas/webhook
MP_WEBHOOK_SECRET=
# Cotización USD → UYU para los precios de tandas.json (si no, se usa 40)
USD_UYU_RATE=
# Emails (entradas, cortesías, avisos): resend | smtp
MAIL_PROVIDER=resend
MAIL_FROM="Ico Batista <entradas@icobatista.com>"
RESEND_API_KEY=
# A quién le llega el aviso de cada venta
ICO_NOTIFY_EMAIL=
# Opcional: protege la tarea diaria /api/entradas/cron (Vercel la envía sola si existe)
CRON_SECRET=
