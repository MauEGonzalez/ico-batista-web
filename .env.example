# Copiá este archivo como ".env" y completá los valores. El .env NUNCA se sube a GitHub.
# En Vercel, estas mismas variables se cargan en: Project → Settings → Environment Variables.

# MongoDB Atlas → tu cluster → Connect → Drivers (reemplazá <password> por la del usuario de la base)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASEÑA@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=icobatista

# Cloudinary → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Clave para firmar las sesiones del panel (mínimo 32 caracteres, al azar). Generala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
